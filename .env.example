# ── Server ──
PORT=3000
NODE_ENV=production

# ── Database Configuration ──
# 'mysql' for Enterprise MySQL 8.4 LTS; automatic fallback to 'sqlite' if offline
DB_DIALECT=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=soukhya_user
MYSQL_PASSWORD=soukhya_secure_pass_2026
MYSQL_DATABASE=soukhya_attendance
MYSQL_CONNECTION_LIMIT=20
DB_PATH=./database/attendance.db

# ── JWT Authentication ──
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=7987566bda4750ae6afe0c967b07a074389edd49ddd6f5ec010df1eb18c9f006256403dae2b1d0e9768af4b9e1f31a47a7fc2bf4d12b92cbbbb19dab65a675b5
JWT_REFRESH_SECRET=ce7238023ba19ba6277622617e9f294c14d8e952baedd99132c5a4e1487fb352342acefbf269de42caa20e6566721fac12c96f0ed540d319bacf1d557ec77897

# ── Token TTLs ──
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── PII Encryption (AES-256-GCM) ──
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PII_ENCRYPTION_KEY=0673da2e3102f4ad23371a5c507736ee68f9bda316ec0e99ff9b883cc07b5693

# ── CORS Whitelist (comma-separated, no spaces) ──
# Example: https://attendance.soukhyatech.local,https://admin.soukhyatech.local
CORS_WHITELIST=http://localhost:3000,http://localhost:5173

# ── Rate Limiting ──
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=500
RATE_LIMIT_AUTH_MAX=100

# ── Cache TTL (seconds) ──
CACHE_TTL_EMPLOYEE=300
CACHE_TTL_STATS=60
CACHE_TTL_ATTENDANCE=43200

# ── Default Admin Credentials (seeded on first boot) ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123