{
  "name": "soukhya-tech",
  "version": "2.0.0",
  "description": "Soukhya Tech Face Recognition Attendance System — Hardened",
  "main": "server.js",
  "scripts": {
    "start": "bash scripts/setup_mysql.sh && node server.js",
    "start:node": "node server.js",
    "start:mysql": "bash scripts/setup_mysql.sh && node server.js",
    "start:all": "python3 start_all.py || python start_all.py",
    "stop:all": "python3 stop_all.py || python stop_all.py",
    "dev": "bash scripts/setup_mysql.sh && nodemon server.js",
    "test": "python3 test_all.py || python test_all.py",
    "test:integration": "node test_integration.js",
    "test:node": "python3 test_all.py node || python test_all.py node",
    "test:java": "python3 test_all.py java || python test_all.py java",
    "build:java": "mvn clean package -DskipTests",
    "optimize:db": "python3 db_optimize.py || python db_optimize.py",
    "antigravity": "./Antigravity-x64/antigravity",
    "antigravity:bg": "nohup ./Antigravity-x64/antigravity >/dev/null 2>&1 &"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.2.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.24.4",
    "node-cache": "^5.1.2",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
